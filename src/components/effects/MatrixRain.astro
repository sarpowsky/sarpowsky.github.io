---
/**
 * The original portfolio's Matrix rain, rebuilt as a restrained backdrop.
 * It is DPR-aware, capped at 30fps, pauses in hidden tabs and renders a static
 * field when the visitor requests reduced motion.
 */
---

<canvas id="matrix-canvas" aria-hidden="true"></canvas>
<div class="backdrop-scrim" aria-hidden="true"></div>

<script>
  const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d', { alpha: false }) ?? null;

  if (canvas && ctx) {
    const CHARS =
      'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%&*+-=[]{}|;:,.<>?/';
    const FONT_SIZE = 11;
    const FRAME_MS = 1000 / 30;

    type Drop = { y: number; speed: number; tone: number };
    type Palette = { bg: string; trail: string; glyph: string; dim: string; head: string };

    let drops: Drop[] = [];
    let palette: Palette;
    let rafId = 0;
    let lastFrame = 0;
    let running = false;

    const readPalette = (): Palette => {
      const css = getComputedStyle(document.documentElement);
      return {
        bg: css.getPropertyValue('--matrix-bg').trim() || '#050806',
        trail: css.getPropertyValue('--matrix-trail').trim() || 'rgb(5 8 6 / 0.1)',
        glyph: css.getPropertyValue('--matrix-glyph').trim() || '#20d94f',
        dim: css.getPropertyValue('--matrix-glyph-dim').trim() || '#087f28',
        head: css.getPropertyValue('--matrix-head').trim() || '#b7ffc8',
      };
    };

    const paintBase = () => {
      ctx.fillStyle = palette.bg;
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.textBaseline = 'top';

      const columns = Math.ceil(window.innerWidth / FONT_SIZE);
      const rows = Math.ceil(window.innerHeight / FONT_SIZE);
      drops = Array.from({ length: columns }, () => ({
        y: Math.random() * (rows + 24) - 24,
        speed: 0.34 + Math.random() * 0.34,
        tone: Math.random(),
      }));
      paintBase();
    };

    const draw = (timestamp: number) => {
      rafId = requestAnimationFrame(draw);
      if (timestamp - lastFrame < FRAME_MS) return;
      lastFrame = timestamp;

      ctx.fillStyle = palette.trail;
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);
      ctx.font = `${FONT_SIZE}px ui-monospace, monospace`;

      for (let column = 0; column < drops.length; column += 1) {
        const drop = drops[column]!;
        const x = column * FONT_SIZE;
        const y = drop.y * FONT_SIZE;

        if (Math.random() > 0.62) {
          const char = CHARS.charAt(Math.floor(Math.random() * CHARS.length));
          ctx.fillStyle =
            Math.random() > 0.94 ? palette.head : drop.tone > 0.22 ? palette.glyph : palette.dim;
          ctx.fillText(char, x, y);
        }

        drop.y += drop.speed;
        if (y > window.innerHeight && Math.random() > 0.965) {
          drop.y = -Math.random() * 24;
          drop.speed = 0.34 + Math.random() * 0.34;
          drop.tone = Math.random();
        }
      }
    };

    const paintStatic = () => {
      paintBase();
      ctx.font = `${FONT_SIZE}px ui-monospace, monospace`;
      ctx.fillStyle = palette.dim;
      const columns = Math.ceil(window.innerWidth / (FONT_SIZE * 2));
      const rows = Math.ceil(window.innerHeight / (FONT_SIZE * 4));
      for (let x = 0; x < columns; x += 1) {
        for (let y = 0; y < rows; y += 1) {
          if ((x * 7 + y * 11) % 5 !== 0) continue;
          const index = (x * 13 + y * 17) % CHARS.length;
          ctx.fillText(CHARS.charAt(index), x * FONT_SIZE * 2, y * FONT_SIZE * 4);
        }
      }
    };

    const start = () => {
      if (running) return;
      running = true;
      lastFrame = 0;
      rafId = requestAnimationFrame(draw);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(rafId);
    };

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sync = () => {
      if (reducedMotion.matches || document.hidden) {
        stop();
        paintStatic();
      } else {
        start();
      }
    };

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        sync();
      }, 150);
    });

    document.addEventListener('visibilitychange', sync);
    reducedMotion.addEventListener('change', sync);
    window.addEventListener('themechange', () => {
      palette = readPalette();
      resize();
      sync();
    });

    palette = readPalette();
    resize();
    sync();
  }
</script>
