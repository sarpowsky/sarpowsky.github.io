---
import type { CollectionEntry } from 'astro:content';
import ExperienceMark from '@components/features/ExperienceMark.astro';
import Icon from '@components/ui/Icon.astro';

interface Props {
  entry: CollectionEntry<'experience'>;
  index: number;
  hasDetails: boolean;
}

const { entry, index, hasDetails } = Astro.props;
---

<li class="experience-item">
  <button
    type="button"
    class="experience-card terminal-window"
    data-modal-open={hasDetails ? `exp-${entry.id}` : undefined}
    aria-haspopup={hasDetails ? 'dialog' : undefined}
    disabled={!hasDetails}
  >
    <span class="experience-card-topline">
      <span aria-hidden="true">EXP_{String(index + 1).padStart(2, '0')}</span>
      <span>{entry.data.type.toUpperCase()}</span>
    </span>

    <span class="experience-card-main">
      <ExperienceMark company={entry.data.company} logo={entry.data.logo} />
      <span class="experience-card-copy">
        <span class="experience-card-role">{entry.data.role}</span>
        <span class="experience-card-company">{entry.data.company}</span>
      </span>
    </span>

    {entry.data.summary && <span class="experience-card-summary">{entry.data.summary}</span>}

    <span class="experience-card-meta">
      <span>
        <Icon name="calendar" size={13} />
        {entry.data.duration}
      </span>
      <span>
        <Icon name="map-pin" size={13} />
        {entry.data.location}
      </span>
    </span>

    {
      hasDetails && (
        <span class="experience-card-action" aria-hidden="true">
          inspect_role <Icon name="chevron-right" size={14} />
        </span>
      )
    }
  </button>
</li>
