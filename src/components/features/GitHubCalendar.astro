---
import contributions from '@/data/github-contributions.json';
import Icon from '@components/ui/Icon.astro';

type Day = { date: string; count: number; level: number };
const days = contributions as Day[];
const total = days.reduce((sum, day) => sum + day.count, 0);
const activeDays = days.filter((day) => day.count > 0).length;
const first = days[0]?.date;
const last = days.at(-1)?.date;
const leadingBlanks = first ? new Date(first).getUTCDay() : 0;

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<div class="contribution-card terminal-window">
  <div class="window-bar" aria-hidden="true">
    <span class="window-dots"><i></i><i></i><i></i></span>
    <span>github/activity.log</span>
    <span>SYNCED</span>
  </div>

  <div class="contribution-body">
    <header class="contribution-header">
      <div>
        <p class="terminal-command"><span aria-hidden="true">$</span> git log --year</p>
        <h3 id="contrib-heading">GitHub contributions</h3>
        {
          first && last && (
            <p>
              {fmt(first)} — {fmt(last)}
            </p>
          )
        }
      </div>
      <a href="https://github.com/sarpowsky" target="_blank" rel="noopener noreferrer">
        @sarpowsky <Icon name="external-link" size={14} />
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </header>

    <dl class="contribution-stats">
      <div><dt>Total commits</dt><dd>{total.toLocaleString()}</dd></div>
      <div><dt>Active days</dt><dd>{activeDays}</dd></div>
      <div><dt>Window</dt><dd>{days.length}d</dd></div>
    </dl>

    <div class="contrib-scroll">
      <div
        class="contrib-grid"
        role="img"
        aria-labelledby="contrib-heading"
        aria-label={`Contribution heatmap: ${total} contributions between ${first && fmt(first)} and ${last && fmt(last)}.`}
      >
        {
          Array.from({ length: leadingBlanks }).map(() => (
            <span class="contrib-cell" data-level="0" />
          ))
        }
        {
          days.map((day) => (
            <span
              class="contrib-cell"
              data-level={day.level}
              title={`${fmt(day.date)}: ${day.count} contribution${day.count === 1 ? '' : 's'}`}
            />
          ))
        }
      </div>
    </div>

    <div class="contribution-footer">
      <span class="contribution-scroll-hint">← scroll to inspect →</span>
      <div class="contribution-legend" aria-hidden="true">
        <span>Less</span>
        {[0, 1, 2, 3, 4].map((level) => <span class="contrib-cell" data-level={level} />)}
        <span>More</span>
      </div>
    </div>
  </div>
</div>
