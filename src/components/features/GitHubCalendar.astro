---
import contributions from '@/data/github-contributions.json';
import Icon from '@components/ui/Icon.astro';
import { getProfile } from '@lib/content';

/**
 * GitHub contribution heatmap.
 *
 * Rendered at build time from a JSON file refreshed weekly by the
 * `update-github-data` workflow. The previous version fetched this file from
 * the browser on every page view -- via a root-absolute path that only resolved
 * on the live domain -- and silently substituted *randomly generated* data when
 * the request failed. Static rendering removes the request, the broken path,
 * and the fabricated-data failure mode in one go.
 */

type Day = { date: string; count: number; level: number };
const days = contributions as Day[];
const { data: profile } = await getProfile();

const total = days.reduce((sum, d) => sum + d.count, 0);
const first = days[0]?.date;
const last = days.at(-1)?.date;

// Pad the first partial week so weekday rows line up (column-major grid,
// Sunday = row 1).
const leadingBlanks = first ? new Date(first).getUTCDay() : 0;

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<section class="contribution-card surface-card" aria-labelledby="contrib-heading">
  <header class="contribution-header">
    <div>
      <h3 id="contrib-heading">GitHub contributions</h3>
      <p>
        {total.toLocaleString()} contributions
        {
          first && last && (
            <>
              {' '}
              · {fmt(first)} – {fmt(last)}
            </>
          )
        }
      </p>
    </div>

    <a href={profile.socials.github} target="_blank" rel="noopener noreferrer">
      View GitHub
      <Icon name="external-link" size={15} />
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </header>

  <div
    class="contrib-scroll"
    role="region"
    tabindex="0"
    aria-label={`Scrollable contribution heatmap: ${total} contributions between ${first && fmt(first)} and ${last && fmt(last)}.`}
  >
    <div class="contrib-grid" aria-hidden="true">
      {
        Array.from({ length: leadingBlanks }).map(() => (
          <span class="contrib-cell" data-level="0" />
        ))
      }
      {
        days.map((day) => (
          <span
            class="contrib-cell"
            data-level={day.level}
            title={`${fmt(day.date)}: ${day.count} contribution${day.count === 1 ? '' : 's'}`}
          />
        ))
      }
    </div>
  </div>

  <footer class="contribution-footer">
    <p class="contribution-scroll-hint">Scroll horizontally to explore</p>
    <div class="contribution-legend" aria-label="Contribution intensity, less to more">
      <span>Less</span>
      {[0, 1, 2, 3, 4].map((level) => <span class="contrib-cell" data-level={level} />)}
      <span>More</span>
    </div>
  </footer>
</section>
