---
import type { CollectionEntry } from 'astro:content';
import Icon from '@components/ui/Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  lead?: boolean;
  compact?: boolean;
}

const { project, index, lead = false, compact = false } = Astro.props;
---

<li
  class:list={[
    'project-card terminal-window',
    { 'project-card-lead': lead, 'project-card-compact': compact },
  ]}
>
  <article>
    <div class="project-card-topline">
      <span aria-hidden="true">PRJ_{String(index + 1).padStart(2, '0')}</span>
      <span class:list={{ 'project-state-featured': project.data.featured }}>
        {project.data.featured ? 'FEATURED' : 'ARCHIVE'}
      </span>
    </div>

    <h3>
      <a href={project.data.link} target="_blank" rel="noopener noreferrer">
        {project.data.title}
        <Icon name="external-link" size={17} />
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </h3>

    <p>{project.data.description}</p>

    {
      project.data.tags.length > 0 && (
        <ul class="project-tags" aria-label="Technologies">
          {project.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="project-card-action" aria-hidden="true">
      <span>open_project</span>
      <Icon name="chevron-right" size={15} />
    </div>
  </article>
</li>
