---
import Icon from '@components/ui/Icon.astro';
import { getProfile } from '@lib/content';
import type { IconName } from '@lib/icons';

const { data: profile } = await getProfile();

// Driven by profile.md, so adding a network is a content edit, not a code edit.
const SOCIALS: { key: keyof typeof profile.socials; icon: IconName; label: string }[] = [
  { key: 'github', icon: 'github', label: 'GitHub' },
  { key: 'linkedin', icon: 'linkedin', label: 'LinkedIn' },
  { key: 'instagram', icon: 'instagram', label: 'Instagram' },
  { key: 'spotify', icon: 'music', label: 'Spotify' },
];

const links = SOCIALS.filter((s) => Boolean(profile.socials[s.key]));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page-shell footer-inner">
    <div>
      <p class="footer-name">{profile.name}</p>
      <p class="footer-meta">© {year} · Designed and built with Astro</p>
    </div>

    <ul class="footer-socials" aria-label="Social profiles">
      {
        links.map((social) => (
          <li>
            <a
              href={profile.socials[social.key]}
              class="social-icon"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={social.icon} label={`${social.label} (opens in a new tab)`} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
