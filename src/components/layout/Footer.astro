---
import Icon from '@components/ui/Icon.astro';
import Clock from '@components/ui/Clock.astro';
import { getProfile } from '@lib/content';
import type { IconName } from '@lib/icons';

const { data: profile } = await getProfile();

const SOCIALS: { key: keyof typeof profile.socials; icon: IconName; label: string }[] = [
  { key: 'github', icon: 'github', label: 'GitHub' },
  { key: 'linkedin', icon: 'linkedin', label: 'LinkedIn' },
  { key: 'instagram', icon: 'instagram', label: 'Instagram' },
  { key: 'spotify', icon: 'music', label: 'Spotify' },
];

const links = SOCIALS.filter((social) => Boolean(profile.socials[social.key]));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page-shell footer-inner">
    <div class="footer-identity">
      <span class="status-dot" aria-hidden="true"></span>
      <div>
        <p>{profile.name}</p>
        <span>© {year} · Built with Astro</span>
      </div>
    </div>

    <ul class="footer-socials" aria-label="Social profiles">
      {
        links.map((social) => (
          <li>
            <a
              href={profile.socials[social.key]}
              class="social-icon"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={social.icon} label={`${social.label} (opens in a new tab)`} />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="footer-clock">
      <span>LOCAL TIME</span>
      <Clock />
    </div>
  </div>
</footer>
