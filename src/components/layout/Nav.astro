---
import { href, isCurrent } from '@lib/paths';
import { NAV_LINKS } from '@lib/nav';
import ThemeToggle from '@components/ui/ThemeToggle.astro';

const pathname = Astro.url.pathname;
---

<header class="site-nav">
  <div class="page-shell nav-shell">
    <a
      href={href('/')}
      class="site-brand"
      aria-label="Sarpowsky, home"
      aria-current={isCurrent(pathname, '/') ? 'page' : undefined}
    >
      <span aria-hidden="true">~/</span>sarpowsky<span class="brand-mark" aria-hidden="true">.</span
      >
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={href(link.href)}
                class="nav-link"
                aria-current={isCurrent(pathname, link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>
