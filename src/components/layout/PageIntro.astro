---
interface Props {
  index: string;
  label: string;
  title: string;
  description: string;
  meta?: string;
}

const { index, label, title, description, meta } = Astro.props;
const route = title.replace(/^\//, '') || 'index';
const hasLongTitle = title.length > 9;
---

<header class="page-intro terminal-window">
  <div class="window-bar" aria-hidden="true">
    <span class="window-dots"><i></i><i></i><i></i></span>
    <span>~/portfolio/{route}.page</span>
    <span>{index}</span>
  </div>

  <div class="page-intro-body">
    <div>
      <p class="eyebrow"><span aria-hidden="true">{index}</span>{label}</p>
      <h1 class:list={{ 'page-intro-title-long': hasLongTitle }}>
        {title}<span aria-hidden="true">_</span>
      </h1>
    </div>
    <div class="page-intro-copy">
      <p>{description}</p>
      {
        meta && (
          <p class="page-intro-meta">
            <span aria-hidden="true">//</span> {meta}
          </p>
        )
      }
    </div>
  </div>
</header>
