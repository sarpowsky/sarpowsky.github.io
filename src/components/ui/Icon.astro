---
import { ICONS, type IconName } from '@lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible label. Omit for purely decorative icons. */
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={ICONS[name]}
/>
