---
import Icon from '@components/ui/Icon.astro';

interface Props {
  id: string;
  /** id of the element inside the panel that names this dialog. */
  labelledby: string;
}

const { id, labelledby } = Astro.props;
---

<dialog id={id} class="modal" aria-labelledby={labelledby}>
  <div class="modal-panel">
    <button type="button" class="modal-close" data-modal-close aria-label="Close">
      <Icon name="x" size={18} />
    </button>
    <slot />
  </div>
</dialog>
