---
import BaseLayout from '@layouts/BaseLayout.astro';
import { href } from '@lib/paths';
import { NAV_LINKS } from '@lib/nav';
---

<BaseLayout title="404 — _sarpowsky" description="This page could not be found.">
  <div class="mx-auto max-w-xl py-16 text-center">
    <p class="text-6xl font-bold text-accent">404</p>
    <h1 class="mt-4 mb-3 text-2xl font-bold">command not found</h1>
    <p class="mb-8 text-fg-muted">That route doesn't exist. Try one of these instead:</p>

    <ul class="flex flex-wrap justify-center gap-4">
      <li><a class="nav-link" href={href('/')}>/home</a></li>
      {
        NAV_LINKS.map((link) => (
          <li>
            <a class="nav-link" href={href(link.href)}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
