---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/layout/PageIntro.astro';
import Icon from '@components/ui/Icon.astro';
import Modal from '@components/ui/Modal.astro';
import ModalController from '@components/ui/modal-controller.astro';
import { getCertificates } from '@lib/content';
import { resolveImage } from '@lib/images';

const certificates = await getCertificates();
---

<BaseLayout
  title="Certificates — _sarpowsky"
  description="Certifications, bootcamps, hackathons, and workshops completed by Sarp Can Karaman."
>
  <div class="section-page">
    <PageIntro
      index="04"
      label="Learning log"
      title="/certificates"
      description="A visual archive of courses, competitions, bootcamps, and workshops that pushed the work forward."
      meta={`${certificates.length} credentials`}
    />

    <ol class="certificate-grid">
      {
        certificates.map((cert, index) => (
          <li class="certificate-card surface-card">
            <article>
              <div class="certificate-media">
                <Image
                  src={resolveImage(cert.data.image)}
                  alt=""
                  width={640}
                  height={426}
                  class="certificate-image"
                  loading="lazy"
                />
              </div>

              <div class="certificate-content">
                <p class="certificate-index" aria-hidden="true">
                  Credential / {String(index + 1).padStart(2, '0')}
                </p>
                <h2>{cert.data.name}</h2>
                <p class="certificate-meta">
                  <Icon name="award" size={13} />
                  {cert.data.issuer} · {cert.data.date}
                </p>
                <button
                  type="button"
                  class="certificate-open"
                  data-modal-open={`cert-${cert.id}`}
                  aria-haspopup="dialog"
                >
                  View credential
                  <Icon name="chevron-right" size={15} />
                </button>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>

  {
    certificates.map((cert) => (
      <Modal id={`cert-${cert.id}`} labelledby={`cert-${cert.id}-title`}>
        <div class="certificate-modal-heading">
          <p class="modal-kicker">{cert.data.issuer}</p>
          <h2 id={`cert-${cert.id}-title`}>{cert.data.name}</h2>
          <p class="modal-meta-line">
            <Icon name="award" size={14} />
            Issued {cert.data.date}
          </p>
        </div>

        <Image
          src={resolveImage(cert.data.image)}
          alt={`${cert.data.name}, issued by ${cert.data.issuer}`}
          width={960}
          height={640}
          class="certificate-modal-image"
        />

        <p class="certificate-description">{cert.data.description}</p>

        {cert.data.credentialUrl && (
          <a
            class="certificate-verify button button-secondary"
            href={cert.data.credentialUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Verify credential
            <Icon name="external-link" size={14} />
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
      </Modal>
    ))
  }

  <ModalController />
</BaseLayout>
