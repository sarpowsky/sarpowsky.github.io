---
import { render } from 'astro:content';
import ExperienceCard from '@components/features/ExperienceCard.astro';
import ExperienceMark from '@components/features/ExperienceMark.astro';
import PageIntro from '@components/layout/PageIntro.astro';
import Icon from '@components/ui/Icon.astro';
import Modal from '@components/ui/Modal.astro';
import ModalController from '@components/ui/modal-controller.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getExperience } from '@lib/content';

const experience = await getExperience();

// Render each entry's Markdown body once, up front, so the template stays
// declarative and every modal has its detail content ready.
const entries = await Promise.all(
  experience.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasDetails: Boolean(entry.body?.trim()),
  }))
);

const workEntries = entries.filter(({ entry }) => entry.data.type !== 'Voluntary');
const communityEntries = entries.filter(({ entry }) => entry.data.type === 'Voluntary');
const lanes = [
  {
    id: 'work-experience',
    index: '01',
    label: 'Professional practice',
    title: 'Work',
    entries: workEntries,
  },
  {
    id: 'community-experience',
    index: '02',
    label: 'Shared practice',
    title: 'Community',
    entries: communityEntries,
  },
];
---

<BaseLayout
  title="Experience — _sarpowsky"
  description="Internships, roles, and volunteer work by Sarp Can Karaman."
>
  <div class="section-page section-page-narrow">
    <PageIntro
      index="03"
      label="Field notes"
      title="/experience"
      description="Professional roles and community work that shaped how I build, lead, and move systems from idea to production."
      meta={`${workEntries.length} work roles · ${communityEntries.length} community positions`}
    />

    <div class="experience-columns">
      {
        lanes.map((lane) => (
          <section class="experience-lane" aria-labelledby={lane.id}>
            <div class="experience-lane-heading">
              <div>
                <p class="eyebrow">
                  <span aria-hidden="true">{lane.index}</span> {lane.label}
                </p>
                <h2 id={lane.id}>{lane.title}</h2>
              </div>
              <span class="experience-lane-count">
                <span class="sr-only">{lane.entries.length} entries</span>
                <span aria-hidden="true">{String(lane.entries.length).padStart(2, '0')}</span>
              </span>
            </div>

            <ol class="experience-list">
              {lane.entries.map(({ entry, hasDetails }, index) => (
                <ExperienceCard entry={entry} index={index} hasDetails={hasDetails} />
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>

  {
    entries.map(
      ({ entry, Content, hasDetails }) =>
        hasDetails && (
          <Modal id={`exp-${entry.id}`} labelledby={`exp-${entry.id}-title`}>
            <div class="modal-heading">
              <ExperienceMark company={entry.data.company} logo={entry.data.logo} />
              <div>
                <p class="modal-kicker">{entry.data.company}</p>
                <h2 id={`exp-${entry.id}-title`}>{entry.data.role}</h2>
              </div>
            </div>

            <div class="modal-meta">
              <span>
                <Icon name="calendar" size={13} />
                {entry.data.duration}
              </span>
              <span>
                <Icon name="map-pin" size={13} />
                {entry.data.location}
              </span>
              <span class="tag">{entry.data.type}</span>
            </div>

            {entry.data.summary && <p class="modal-summary">{entry.data.summary}</p>}

            <div class="prose-content modal-prose">
              <Content />
            </div>
          </Modal>
        )
    )
  }

  <ModalController />
</BaseLayout>
