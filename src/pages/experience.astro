---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/layout/PageIntro.astro';
import Icon from '@components/ui/Icon.astro';
import Modal from '@components/ui/Modal.astro';
import ModalController from '@components/ui/modal-controller.astro';
import { getExperience } from '@lib/content';
import { resolveImage } from '@lib/images';

const experience = await getExperience();

// Render each entry's Markdown body once, up front, so the template stays
// declarative and every modal has its detail content ready.
const entries = await Promise.all(
  experience.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasDetails: Boolean(entry.data.summary || entry.body?.trim()),
  }))
);
---

<BaseLayout
  title="Experience — _sarpowsky"
  description="Internships, roles, and volunteer work by Sarp Can Karaman."
>
  <div class="section-page section-page-narrow">
    <PageIntro
      index="03"
      label="Field notes"
      title="/experience"
      description="Roles, internships, and communities that shaped how I build, collaborate, and turn data into decisions."
      meta={`${entries.length} roles and collaborations`}
    />

    <ol class="experience-timeline">
      {
        entries.map(({ entry, hasDetails }, index) => (
          <li class="experience-item">
            <div class="experience-marker" aria-hidden="true">
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>

            <article class="experience-card surface-card">
              <Image
                src={resolveImage(entry.data.logo)}
                alt=""
                width={64}
                height={64}
                class="card-logo"
                loading="lazy"
              />

              <div class="experience-content">
                <div class="experience-title-row">
                  <div>
                    <p class="experience-company">{entry.data.company}</p>
                    <h2>{entry.data.role}</h2>
                  </div>
                  <span
                    class:list={['tag', { 'tag-current': entry.data.duration.includes('Ongoing') }]}
                  >
                    {entry.data.type}
                  </span>
                </div>

                <div class="experience-meta">
                  <span>
                    <Icon name="calendar" size={13} />
                    {entry.data.duration}
                  </span>
                  <span>
                    <Icon name="map-pin" size={13} />
                    {entry.data.location}
                  </span>
                </div>

                {entry.data.summary && <p class="experience-summary">{entry.data.summary}</p>}

                {hasDetails && (
                  <button
                    type="button"
                    class="experience-open"
                    data-modal-open={`exp-${entry.id}`}
                    aria-haspopup="dialog"
                  >
                    View role details
                    <Icon name="chevron-right" size={15} />
                  </button>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>

  {
    entries.map(
      ({ entry, Content, hasDetails }) =>
        hasDetails && (
          <Modal id={`exp-${entry.id}`} labelledby={`exp-${entry.id}-title`}>
            <div class="modal-heading">
              <Image
                src={resolveImage(entry.data.logo)}
                alt=""
                width={56}
                height={56}
                class="card-logo"
              />
              <div>
                <p class="modal-kicker">{entry.data.company}</p>
                <h2 id={`exp-${entry.id}-title`}>{entry.data.role}</h2>
              </div>
            </div>

            <div class="modal-meta">
              <span>
                <Icon name="calendar" size={13} />
                {entry.data.duration}
              </span>
              <span>
                <Icon name="map-pin" size={13} />
                {entry.data.location}
              </span>
              <span class="tag">{entry.data.type}</span>
            </div>

            {entry.data.summary && <p class="modal-summary">{entry.data.summary}</p>}

            <div class="prose-content modal-prose">
              <Content />
            </div>
          </Modal>
        )
    )
  }

  <ModalController />
</BaseLayout>
