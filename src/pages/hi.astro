---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/layout/PageIntro.astro';
import { getAbout, getSkills } from '@lib/content';

const about = await getAbout();
const { Content } = await render(about);
const skills = await getSkills();
---

<BaseLayout
  title={`${about.data.greeting} — _sarpowsky`}
  description={`${about.data.greeting}, ${about.data.subtitle}`}
>
  <div class="section-page">
    <PageIntro
      index="01"
      label="Identity / profile"
      title={`/${about.data.title}`}
      description="The person behind the terminal: what I build, how I learn, and the systems I am growing into."
      meta={`${skills.length} areas of practice`}
    />

    <article class="about-card terminal-window">
      <div class="window-bar" aria-hidden="true">
        <span class="window-dots"><i></i><i></i><i></i></span>
        <span>~/portfolio/readme.md</span>
        <span>UTF-8</span>
      </div>
      <div class="about-card-body">
        <div class="about-card-aside" aria-hidden="true">
          <span>PROFILE_01</span>
          <span class="about-rule"></span>
          <span>SC_K</span>
        </div>
        <div>
          <p class="about-greeting">{about.data.greeting}<span aria-hidden="true">.</span></p>
          <p class="about-subtitle">{about.data.subtitle}</p>
          <div class="prose-content about-prose"><Content /></div>
        </div>
      </div>
    </article>

    {
      skills.length > 0 && (
        <section class="skills-section" aria-labelledby="skills-heading">
          <div class="section-heading-row">
            <div>
              <p class="eyebrow">
                <span aria-hidden="true">02</span>Working toolkit
              </p>
              <h2 id="skills-heading">Skills in practice</h2>
            </div>
            <p class="section-note">
              A working map of the tools I use from raw data to production.
            </p>
          </div>

          <div class="skill-groups">
            {skills.map((group) => (
              <article class="skill-group terminal-window">
                <header>
                  <span aria-hidden="true">MOD_{String(group.data.order).padStart(2, '0')}</span>
                  <h3>{group.data.name}</h3>
                </header>
                <ul>
                  {group.data.items.map((skill) => (
                    <li>
                      <div class="skill-label">
                        <span>{skill.name}</span>
                        <span>{String(skill.level).padStart(2, '0')}%</span>
                      </div>
                      <div
                        class="skill-meter"
                        role="progressbar"
                        aria-label={skill.name}
                        aria-valuenow={skill.level}
                        aria-valuemin="0"
                        aria-valuemax="100"
                      >
                        <span class="skill-meter-fill" style={`--skill-level: ${skill.level}%`} />
                      </div>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
