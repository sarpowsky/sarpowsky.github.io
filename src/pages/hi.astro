---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/layout/PageIntro.astro';
import { getAbout, getSkills } from '@lib/content';

const about = await getAbout();
const { Content } = await render(about);
const skills = await getSkills();
---

<BaseLayout
  title={`${about.data.greeting} — _sarpowsky`}
  description={`${about.data.greeting}, ${about.data.subtitle}`}
>
  <div class="section-page">
    <PageIntro
      index="01"
      label="Profile"
      title={`/${about.data.title}`}
      description={`${about.data.greeting} — ${about.data.subtitle}.`}
      meta={`${skills.length} areas of practice`}
    />

    <article class="about-card surface-card">
      <div class="about-card-label" aria-hidden="true">
        <span>readme.md</span>
        <span>about / personal</span>
      </div>
      <div class="prose-content about-prose"><Content /></div>
    </article>

    {
      skills.length > 0 && (
        <section class="skills-section" aria-labelledby="skills-heading">
          <div class="section-heading-row">
            <div>
              <p class="eyebrow">
                <span aria-hidden="true">02</span> Working toolkit
              </p>
              <h2 id="skills-heading">Skills in practice</h2>
            </div>
            <p class="section-note">Tools I use to move from messy data to working software.</p>
          </div>

          <div class="skill-groups">
            {skills.map((group) => (
              <article class="skill-group surface-card">
                <span class="skill-group-number" aria-hidden="true">
                  {String(group.data.order).padStart(2, '0')}
                </span>
                <h3>{group.data.name}</h3>
                <ul>
                  {group.data.items.map((skill) => (
                    <li>{skill.name}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
