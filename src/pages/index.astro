---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/features/ProjectCard.astro';
import Icon from '@components/ui/Icon.astro';
import { getProfile, getProjects } from '@lib/content';
import { resolveImage } from '@lib/images';
import { href } from '@lib/paths';

const { data: profile } = await getProfile();
const projects = await getProjects();
const allFeaturedProjects = projects.filter((project) => project.data.featured);
const featuredProjects = allFeaturedProjects.slice(0, 3);
const technologyCount = new Set(projects.flatMap((project) => project.data.tags)).size;
const mailto = `mailto:${encodeURIComponent(profile.email).replace(/%40/g, '@')}`;
---

<BaseLayout title={`${profile.name} — ${profile.title}`} description={profile.tagline}>
  <div class="home-page">
    <section class="home-console terminal-window" aria-labelledby="home-heading">
      <div class="window-bar" aria-hidden="true">
        <span class="window-dots"><i></i><i></i><i></i></span>
        <span>~/portfolio/main.session</span>
        <span>LIVE</span>
      </div>

      <div class="home-hero">
        <div class="home-hero-copy">
          <p class="terminal-command"><span aria-hidden="true">$</span> whoami</p>
          <p class="hero-kicker">ML ENGINEERING · DATA SYSTEMS · CLOUD</p>
          <h1 id="home-heading" class="home-title">
            <span>Hello, I’m</span>
            {profile.name}<b aria-hidden="true">.</b>
          </h1>
          <p class="home-intro">{profile.tagline}</p>

          <div class="home-actions">
            <a class="button button-primary" href={href('/projects')}>
              Explore my work
              <Icon name="chevron-right" size={18} />
            </a>
            <a class="button button-secondary" href={mailto}>
              <Icon name="mail" size={17} />
              Let’s talk
            </a>
          </div>

          <div class="home-focus" aria-label="Areas of focus">
            <span>FOCUS</span>
            <ul>
              <li>Machine Learning</li>
              <li>Data Engineering</li>
              <li>Cloud & DevOps</li>
            </ul>
          </div>
        </div>

        <figure class="home-portrait-wrap">
          <div class="portrait-scanline" aria-hidden="true"></div>
          <Image
            src={resolveImage(profile.avatar)}
            alt={`Portrait of ${profile.name}`}
            width={620}
            height={620}
            loading="eager"
            fetchpriority="high"
            class="home-portrait"
          />
          <figcaption>
            <span>SC_K / PROFILE</span>
            <span>İSTANBUL · TR</span>
          </figcaption>
          <span class="portrait-corner portrait-corner-tl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-tr" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-bl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-br" aria-hidden="true"></span>
        </figure>
      </div>

      <dl class="home-stats" aria-label="Portfolio at a glance">
        <div>
          <dt>Projects shipped</dt>
          <dd>{String(projects.length).padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>Featured builds</dt>
          <dd>{String(allFeaturedProjects.length).padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>Technologies used</dt>
          <dd>{String(technologyCount).padStart(2, '0')}</dd>
        </div>
      </dl>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="home-work" aria-labelledby="selected-work-heading">
          <div class="section-heading-row">
            <div>
              <p class="eyebrow">
                <span aria-hidden="true">01</span>Proof of work
              </p>
              <h2 id="selected-work-heading">Selected projects</h2>
            </div>
            <div class="section-heading-aside">
              <p>Systems designed beyond the prototype: tested, deployed, and documented.</p>
              <a class="text-link" href={href('/projects')}>
                View all projects
                <Icon name="chevron-right" size={15} />
              </a>
            </div>
          </div>

          <ol class="project-grid home-project-grid">
            {featuredProjects.map((project, index) => (
              <ProjectCard project={project} index={index} compact />
            ))}
          </ol>
        </section>
      )
    }
  </div>
</BaseLayout>
