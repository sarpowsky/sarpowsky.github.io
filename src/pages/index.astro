---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/ui/Icon.astro';
import { getProfile, getProjects } from '@lib/content';
import { resolveImage } from '@lib/images';
import { href } from '@lib/paths';

const { data: profile } = await getProfile();
const projects = await getProjects();
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const technologyCount = new Set(projects.flatMap((project) => project.data.tags)).size;

// The schema already guarantees a well-formed address, but the value is still
// encoded here so a stray `?` or `&` could never inject extra mailto header
// fields (bcc, subject). `@` is restored afterwards because RFC 6068 wants it
// literal in the addr-spec, and some mail clients mishandle `%40`.
const mailto = `mailto:${encodeURIComponent(profile.email).replace(/%40/g, '@')}`;
---

<BaseLayout title={`${profile.name} — ${profile.title}`} description={profile.tagline}>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="home-hero-copy">
        <p class="eyebrow"><span aria-hidden="true">01</span> Computer engineer in progress</p>
        <h1 id="home-heading" class="home-title">
          <span>Hello, I’m</span>
          {profile.name}.
        </h1>
        <p class="home-intro">{profile.tagline}</p>

        <div class="home-actions">
          <a class="button button-primary" href={href('/projects')}>
            Explore my work
            <Icon name="chevron-right" size={18} />
          </a>
          <a class="button button-secondary" href={mailto}>
            <Icon name="mail" size={18} />
            Let’s talk
          </a>
          <!-- Same-origin, so `download` is honoured. -->
          <a
            class="text-link"
            href={href(profile.resume)}
            download
            aria-label="Download résumé (PDF)"
          >
            <Icon name="download" size={16} />
            Résumé
          </a>
        </div>
      </div>

      <div class="home-portrait-wrap">
        <div class="home-portrait-frame">
          <span class="portrait-corner portrait-corner-top" aria-hidden="true">SC_K</span>
          <Image
            src={resolveImage(profile.avatar)}
            alt={`Portrait of ${profile.name}`}
            width={560}
            height={560}
            loading="eager"
            fetchpriority="high"
            class="home-portrait"
          />
          <span class="portrait-corner portrait-corner-bottom" aria-hidden="true">
            İstanbul · TR
          </span>
        </div>
      </div>
    </section>

    <dl class="home-stats" aria-label="Portfolio at a glance">
      <div>
        <dt>Projects</dt>
        <dd>{String(projects.length).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>Featured builds</dt>
        <dd>{String(featuredProjects.length).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>Technologies explored</dt>
        <dd>{String(technologyCount).padStart(2, '0')}</dd>
      </div>
    </dl>

    {
      featuredProjects.length > 0 && (
        <section class="home-work" aria-labelledby="selected-work-heading">
          <div class="section-heading-row">
            <div>
              <p class="eyebrow">
                <span aria-hidden="true">02</span> Proof of work
              </p>
              <h2 id="selected-work-heading">Selected projects</h2>
            </div>
            <a class="text-link" href={href('/projects')}>
              View all projects
              <Icon name="chevron-right" size={16} />
            </a>
          </div>

          <ol class="featured-projects">
            {featuredProjects.map((project, index) => (
              <li>
                <a
                  class="featured-project"
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="featured-project-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="featured-project-content">
                    <span class="featured-project-title">
                      {project.data.title}
                      <Icon name="external-link" size={17} />
                    </span>
                    <span class="featured-project-description">{project.data.description}</span>
                    <span class="featured-project-tags">
                      {project.data.tags.map((tag) => (
                        <span>{tag}</span>
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</BaseLayout>
