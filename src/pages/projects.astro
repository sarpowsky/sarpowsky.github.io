---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/layout/PageIntro.astro';
import GitHubCalendar from '@components/features/GitHubCalendar.astro';
import ProjectCard from '@components/features/ProjectCard.astro';
import { getProjects } from '@lib/content';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const archive = projects.filter((project) => !project.data.featured);
---

<BaseLayout
  title="Projects — _sarpowsky"
  description="Machine learning, data engineering, and full-stack projects by Sarp Can Karaman."
>
  <div class="section-page">
    <PageIntro
      index="02"
      label="Selected work"
      title="/projects"
      description="Machine learning experiments, data products, and useful software—built to turn ideas into systems that work."
      meta={`${projects.length} projects · ${featured.length} featured`}
    />

    {
      featured.length > 0 && (
        <section class="project-section" aria-labelledby="featured-projects-heading">
          <div class="section-heading-row">
            <div>
              <p class="eyebrow">
                <span aria-hidden="true">01</span> Highlights
              </p>
              <h2 id="featured-projects-heading">Featured builds</h2>
            </div>
            <p class="section-note">Deeper, end-to-end work across ML, data, and product.</p>
          </div>

          <ol class="project-grid project-grid-featured">
            {featured.map((project, index) => (
              <ProjectCard project={project} index={index} lead={index === 0} />
            ))}
          </ol>
        </section>
      )
    }

    {
      archive.length > 0 && (
        <section class="project-section" aria-labelledby="project-archive-heading">
          <div class="section-heading-row">
            <div>
              <p class="eyebrow">
                <span aria-hidden="true">02</span> More experiments
              </p>
              <h2 id="project-archive-heading">Project archive</h2>
            </div>
          </div>

          <ol class="project-grid">
            {archive.map((project, index) => (
              <ProjectCard project={project} index={featured.length + index} />
            ))}
          </ol>
        </section>
      )
    }

    <section class="activity-section" aria-labelledby="activity-heading">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow"><span aria-hidden="true">03</span> In the open</p>
          <h2 id="activity-heading">Building history</h2>
        </div>
        <p class="section-note">A year of public commits, experiments, and iteration.</p>
      </div>

      <GitHubCalendar />
    </section>
  </div>
</BaseLayout>
